# ============================================================
# 复制本文件为 .env 并填写真实值后，再启动后端
# ============================================================

# OpenAI 兼容网关的 API Key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容网关的 Base URL（如使用官方 api.openai.com 可留空不设置）
# 示例：DeepSeek、SiliconFlow、Zhipu BigModel、one-api/new-api 等
OPENAI_BASE_URL=https://your-gateway.example.com/v1

# ============================================================
# 多模态视觉 LLM（独立 API，OpenAI 兼容格式）
# 用于识别概念投放中的图片/视频，生成客观外观描述
# 默认示例：智谱 GLM-4.6V
# ============================================================
VISION_API_KEY=your-vision-api-key
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
VISION_MODEL=glm-4.6v
